#!/bin/sh
# Back up credentials privately before the idempotent 4.0.0 server migration.
set -eu
umask 077
[ -s /etc/config/passwall2_server ] || exit 0
status=0
lua /usr/share/passwall2/migrate_401.lua check || status=$?
case "$status" in 0) ;; 2) exit 0 ;; *) exit "$status" ;; esac
backup=/etc/boltwrt/migrations/4.0.1
mkdir -p "$backup"
chmod 700 /etc/boltwrt /etc/boltwrt/migrations "$backup"
if [ ! -e "$backup/passwall2_server" ]; then
    cp /etc/config/passwall2_server "$backup/passwall2_server"
    chmod 600 "$backup/passwall2_server"
fi
lua /usr/share/passwall2/migrate_401.lua apply
