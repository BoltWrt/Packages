#!/bin/sh
# Upgrade preparation requires a user-exported backup. Do not retain a second
# credential archive on the router; sysupgrade supplies the working config.
set -eu
umask 077
status=0
lua /usr/share/passwall2/migrate_401.lua check || status=$?
case "$status" in 0) ;; 2) exit 0 ;; *) exit "$status" ;; esac
lua /usr/share/passwall2/migrate_401.lua apply
